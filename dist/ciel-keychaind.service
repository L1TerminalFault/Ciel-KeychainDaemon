[Unit]
Description=Secret Service Keyring Daemon
Documentation=man:ciel-keychaind(1) https://specifications.freedesktop.org/secret-service/
Before=graphical-session.target
Wants=graphical-session-pre.target

[Service]
Type=notify
ExecStart=/usr/bin/ciel-keychaind
Restart=on-failure
RestartSec=1s

# Sandboxing & Hardening
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=%h/.local/share/keyrings %t
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service @memlock
LimitMEMLOCK=67108864

[Install]
WantedBy=default.target
